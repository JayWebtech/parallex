{
  "name": "@parallax/collector",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/load.ts"
  },
  "dependencies": {
    "@parallax/db": "workspace:*",
    "@parallax/path-normalizer": "workspace:*",
    "@parallax/shared": "workspace:*",
    "fastify": "5.12.8",
    "protobufjs": "8.8.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "autocannon": "9.0.0"
  }
}
