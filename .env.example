# Parallax configuration. Copy to .env, or run scripts/init-env.sh to generate
# one with random secrets. Never commit .env.

# ── Public edge ─────────────────────────────────────────────────────────────
# Origin users and tenant sites reach. Used in tracking snippets and auth.
PUBLIC_URL=http://localhost:8080
# Caddy site address: ":80" locally (HTTP on HTTP_PORT); the bare hostname in
# production (e.g. parallax.example.org), which enables automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Hosting region, shown in the privacy notice (data residency).
DATA_REGION=eu-central (Germany)

# ── Postgres (one instance; separate databases and roles) ──────────────────
POSTGRES_PASSWORD=change-me
UMAMI_DB_PASSWORD=change-me
# Owns the parallax schema; used only by the one-shot `setup` migration job.
PARALLAX_OWNER_PASSWORD=change-me
# Runtime role for the portal: data access only, no DDL.
PARALLAX_APP_PASSWORD=change-me
# Local-only debug ports (bound to 127.0.0.1). Leave unset in production.
POSTGRES_HOST_PORT=55432
UMAMI_HOST_PORT=3001

# ── Umami (internal only; never exposed publicly) ──────────────────────────
# Required by Umami ≥ 3.5. 64 hex chars: openssl rand -hex 32
UMAMI_APP_SECRET=change-me
# The setup job replaces Umami's seeded admin/umami password with this one.
UMAMI_ADMIN_PASSWORD=change-me-at-least-12-chars

# ── Portal ─────────────────────────────────────────────────────────────────
# Session signing secret, ≥ 32 chars: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Comma-separated emails with operator (SCF) access. There is no other way to
# become an operator.
OPERATOR_EMAILS=
# Maximum active projects per account.
MAX_PROJECTS_PER_USER=10
# Account sign-ups per client IP per 5 minutes (raise for events or shared office IPs).
SIGNUP_RATE_LIMIT=5

# ── Stellar ID verification ────────────────────────────────────────────────
# Horizon (accounts) defaults to SDF's public servers; override if needed.
# STELLAR_HORIZON_MAINNET_URL=https://horizon.stellar.org
# STELLAR_HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
# STELLAR_RPC_TESTNET_URL=https://soroban-testnet.stellar.org
# SDF runs no public mainnet RPC. Without this, mainnet *contracts* cannot be
# verified (accounts still can, via Horizon). Use your own node or a provider
# from https://developers.stellar.org/docs/data/apis/rpc/providers
STELLAR_RPC_MAINNET_URL=

# ── Local development (pnpm dev, outside Docker) ───────────────────────────
# DATABASE_URL=postgresql://parallax_app:<PARALLAX_APP_PASSWORD>@127.0.0.1:55432/parallax
# UMAMI_URL=http://127.0.0.1:3001
